OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false
# ---------------------------------------------------------------------------
# Added by this fork (see README.md). Any LangChain "provider:model" id works.
# ---------------------------------------------------------------------------
RESEARCH_MODEL=deepseek:deepseek-chat
SUMMARIZATION_MODEL=deepseek:deepseek-chat
COMPRESSION_MODEL=deepseek:deepseek-chat
FINAL_REPORT_MODEL=deepseek:deepseek-chat
DEEPSEEK_API_KEY=

# Long-term memory (mem0 cloud). Leave empty to run without memory.
MEM0_API_KEY=

# The database the data-analyst agent queries (SQLite file or a PostgreSQL URL). Use a READ-ONLY account.
INTERNAL_DB_URL=sqlite:///./test.db

# HTTP service (python -m open_deep_research.service)
ODR_REDIS_URL=redis://localhost:6390/0
# "api-key:user" pairs. The user id is the only identity the service trusts.
ODR_API_KEYS=change-me-alice:alice,change-me-bob:bob
# Who may open /dashboard and approve requests for row-level order data (comma separated user ids)
ODR_ADMINS=
ODR_APPROVERS=
# Optional: USD per million tokens, to show estimated cost. Never guessed - leave empty to show tokens only.
# ODR_PRICE_IN_PER_M=
# ODR_PRICE_OUT_PER_M=
# Optional: per-user daily token budget (0 = off)
# ODR_DAILY_TOKEN_BUDGET=0
